# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ironclaw

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Logging
RUST_LOG=info

# IronClaw Gateway URL（主项目 Web Gateway 地址）
IRONCLAW_GATEWAY_URL=http://127.0.0.1:38080

# Skill scanner (Task 1.2 / 1.2b)
SCANNER_ENABLED=true
SCANNER_URL=http://127.0.0.1:8000
SCANNER_TIMEOUT_MS=30000
