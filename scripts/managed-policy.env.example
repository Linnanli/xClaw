# Managed policy signing and verification example configuration
# Copy values into your shell environment or .env as needed.
#
# Key material format:
# - Signing key: base64 of 32-byte Ed25519 seed
# - Verify key: base64 of 32-byte Ed25519 public key

# -----------------------------------------------------------------------------
# Mode A: single key (backward-compatible)
# -----------------------------------------------------------------------------
# Admin backend
MANAGED_POLICY_KEY_ID=managed-policy-key-v1
MANAGED_POLICY_SIGNING_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_SEED

# Desktop client
MANAGED_POLICY_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_PUBLIC_KEY

# -----------------------------------------------------------------------------
# Mode B: key rotation (recommended)
# -----------------------------------------------------------------------------
# Admin backend: provide key map and choose active key for signing
# MANAGED_POLICY_SIGNING_KEYS_JSON='{
#   "managed-policy-key-v1": "BASE64_SEED_V1",
#   "managed-policy-key-v2": "BASE64_SEED_V2"
# }'
# MANAGED_POLICY_ACTIVE_KEY_ID=managed-policy-key-v2

# Desktop client: provide verify key map, keyed by key_id
# MANAGED_POLICY_PUBLIC_KEYS_JSON='{
#   "managed-policy-key-v1": "BASE64_PUB_V1",
#   "managed-policy-key-v2": "BASE64_PUB_V2"
# }'

# Optional policy TTL (seconds), default 300
# managed_policy_ttl_seconds is read from system_settings in admin DB.
# You can set it from admin panel settings if needed.
