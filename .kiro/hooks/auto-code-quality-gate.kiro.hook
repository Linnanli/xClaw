{
  "enabled": false,
  "name": "Auto Code Quality Gate on Save",
  "description": "Automatically runs code quality checks (clippy, formatting, tests) whenever Rust source files are saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.rs"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "node -e \"const os = require('os'); const { execSync } = require('child_process'); const isWindows = os.platform() === 'win32'; const cmd = isWindows ? 'powershell -NoProfile -ExecutionPolicy Bypass -File scripts/code-quality-gate.ps1' : 'bash scripts/code-quality-gate.sh'; execSync(cmd, { stdio: 'inherit' });\"",
    "timeout": 120
  }
}