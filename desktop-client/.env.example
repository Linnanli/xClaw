# ============================================
# IronClaw Desktop Client 环境变量配置
# ============================================
# 复制此文件为 .env 并根据需要修改
#
# 配置加载优先级（高 → 低）：
#   1. 管理端下发（admin_config.json，set_var 强制覆盖）
#   2. 显式环境变量（shell export）
#   3. 本地 .env 文件（dotenvy，不覆盖已有变量）
#   4. 客户端默认值（DATABASE_BACKEND=libsql 等）
#
# ⚠️ 客户端数据与全局 ~/.ironclaw/ 完全隔离
#    数据目录: ~/Library/Application Support/ironclaw-desktop/

# ============================================
# 🔴 必需：LLM 配置（至少配置一种后端）
# ============================================

# LLM 后端类型
# 可选值: anthropic, openai, bedrock, ollama, nearai, openai_compatible
LLM_BACKEND=anthropic

# LLM API Key（根据后端类型选择对应的 Key）
# Anthropic: sk-ant-xxx
# OpenAI: sk-xxx
# Bedrock: 使用 AWS 凭证，无需此项
LLM_API_KEY=

# LLM 模型名称（可选，有默认值）
# Anthropic 默认: claude-sonnet-4-20250514
# OpenAI 默认: gpt-4o
# LLM_MODEL=claude-sonnet-4-20250514

# 自定义 API Base URL（仅 openai_compatible 后端需要）
# LLM_BASE_URL=https://api.example.com/v1

# ============================================
# 🟡 可选：数据库配置
# ============================================

# 数据库 URL（默认使用本地 libSQL）
# 留空则使用默认路径: ~/.ironclaw/ironclaw.db
# DATABASE_URL=libsql://localhost:8080

# ============================================
# 🟡 可选：实例标识
# ============================================

# Owner ID（多用户隔离标识，默认 "default"）
# IRONCLAW_OWNER_ID=default

# ============================================
# 🟢 可选：管理端配置
# ============================================

# 管理后台 URL（用于配置同步和数据上报）
# ADMIN_API_URL=https://admin.example.com/api

# 管理端 API Key
# ADMIN_API_KEY=

# 配置同步间隔（秒，默认 300）
# ADMIN_SYNC_INTERVAL=300

# ============================================
# 🟢 可选：安全配置
# ============================================

# 最大输出长度（默认 100000）
# SAFETY_MAX_OUTPUT_LENGTH=100000

# 是否启用注入检查（默认 true）
# SAFETY_INJECTION_CHECK=true

# ============================================
# 🟢 可选：日志和调试
# ============================================

# 日志级别过滤器
# RUST_LOG=info,desktop_client=debug,ironclaw=info

# 环境类型 (development, production)
ENVIRONMENT=development
