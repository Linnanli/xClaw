# Ironclaw Desktop Client 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ============================================
# API 配置
# ============================================

# API 基础 URL
API_BASE_URL=http://localhost:3000

# API 连接超时时间（秒）
API_TIMEOUT_SECS=30

# API 重试次数
API_RETRY_COUNT=3

# 认证方法 (header, url_parameter, both)
AUTH_METHOD=header

# ============================================
# 网络配置
# ============================================

# 网络连接超时时间（秒）
NETWORK_CONNECT_TIMEOUT_SECS=10

# 网络请求超时时间（秒）
NETWORK_REQUEST_TIMEOUT_SECS=30

# 网络最大重试次数
NETWORK_MAX_RETRIES=3

# 网络重试延迟（毫秒）
NETWORK_RETRY_DELAY_MS=100

# 网络重试指数退避因子
NETWORK_RETRY_BACKOFF_FACTOR=2.0

# 最大连接数
NETWORK_MAX_CONNECTIONS=100

# 连接池空闲超时时间（秒）
NETWORK_POOL_IDLE_TIMEOUT_SECS=60

# 是否启用 HTTP/2
NETWORK_ENABLE_HTTP2=true

# 是否启用 gzip 压缩
NETWORK_ENABLE_GZIP=true

# 是否验证 SSL 证书
NETWORK_VERIFY_SSL=false

# ============================================
# 数据库配置
# ============================================

# 数据库类型 (sqlite, postgresql)
DATABASE_TYPE=sqlite

# 数据库 URL（可选，如果设置则覆盖其他数据库配置）
# DATABASE_URL=sqlite:///path/to/ironclaw.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ironclaw

# SQLite 数据库文件路径（仅当 DATABASE_TYPE=sqlite 时使用）
# DATABASE_PATH=/path/to/ironclaw.db

# PostgreSQL 配置（仅当 DATABASE_TYPE=postgresql 时使用）
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=ironclaw
# DATABASE_USER=postgres
# DATABASE_PASSWORD=password

# ============================================
# CORS 配置
# ============================================

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# 日志配置
# ============================================

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# 环境配置
# ============================================

# 环境类型 (development, testing, production)
ENVIRONMENT=development

# ============================================
# 开发环境特定配置
# ============================================

# 是否启用热重载
ENABLE_HOT_RELOAD=true

# 是否启用调试模式
DEBUG_MODE=false

# ============================================
# 生产环境特定配置
# ============================================

# API 密钥（生产环境必需）
# API_KEY=your-api-key-here

# 认证令牌（如果不使用令牌管理器）
# AUTH_TOKEN=your-auth-token-here
