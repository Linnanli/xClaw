# NPM 镜像配置
# 选择一个适合你的镜像源

# 推荐：官方镜像（最可靠，所有版本都有）
registry=https://registry.npmjs.org/
cypress_download_mirror=https://download.cypress.io

# 备选1：阿里云镜像（npmmirror - 原淘宝镜像，可能版本不全）
# registry=https://registry.npmmirror.com
# cypress_download_mirror=https://cdn.npmmirror.com/binaries/cypress/
# cypress_download_path_template=${endpoint}/desktop/${platform}-${arch}/cypress.zip

# 备选2：腾讯云镜像
# registry=https://mirrors.cloud.tencent.com/npm/
# cypress_download_mirror=https://mirrors.cloud.tencent.com/npm/cypress/
# cypress_download_path_template=${endpoint}/${platform}-${arch}/cypress.zip

# 备选3：华为云镜像
# registry=https://repo.huaweicloud.com/repository/npm/
# cypress_download_mirror=https://repo.huaweicloud.com/repository/npm/cypress/
# cypress_download_path_template=${endpoint}/${platform}-${arch}/cypress.zip

# 备选4：清华大学镜像
# registry=https://mirrors.tuna.tsinghua.edu.cn/npm/
# cypress_download_mirror=https://mirrors.tuna.tsinghua.edu.cn/npm/cypress/
# cypress_download_path_template=${endpoint}/${platform}-${arch}/cypress.zip

# 其他配置
npm_config_loglevel=warn
npm_config_progress=true



