{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src-tauri/target/debug",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ironclaw Desktop",
        "width": 1200,
