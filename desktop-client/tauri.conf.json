{
  "productName": "Ironclaw Desktop",
  "version": "0.1.0",
  "identifier": "com.ironclaw.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "./src-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Ironclaw Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
